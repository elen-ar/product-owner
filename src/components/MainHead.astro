---
import { site } from "../../data/site";
interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

//const { title = "Elena Reznikova | Product Owner · Web Strategy · UX", description = "Description text" } = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta charset="UTF-8" />
<meta name="description" property="og:description" content={site.meta.description} />
<title>{site.meta.title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Mono:wght@400;500&display=&family=Oswald:wght@200..700&display=swap&family=Arbutus+Slab" rel="stylesheet" />
<link rel="stylesheet" href="../styles/styles.css" />
