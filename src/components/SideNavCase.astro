---
import { site } from "../../data/site";
import photo from "../images/ElenaReznikovaCV.jpg";
import { getCollection } from "astro:content";
import Home from "../components/Home.astro";
import SideNavFooter from "../components/SideNavFooter.astro";
interface Props {
  current?: string | undefined;
}
const { current } = Astro.props;

const cases = await getCollection("cases");
---

<aside id="sidebar">
  <div>
    <Home />

    <!-- Nav -->
    <ul class="sb-nav-cases" id="sb-nav-cases">
      {cases.map((item: any) => (
        <li>
          <a data-id={item.id} href={`../../cases/${item.id}/`} class={item.id === current ? "active" : ""}>
            <span class="dash" />
            {item.data.title}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bottom -->
  <SideNavFooter />
</aside>
