---
import { site } from "../../data/site";
import { navLinks } from "../../data/nav";
import Home from "../components/Home.astro";
import SideNavFooter from "../components/SideNavFooter.astro";
---

<aside id="sidebar">
  <div>
    <Home />
    <!-- Nav -->
    <ul class="sb-nav" id="sb-nav">
      {navLinks.map((link) => (
        <li>
          <a data-id={link.href} href={`#${link.href}`}>
            <span class="dash" />
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bottom -->
  <SideNavFooter />
</aside>
